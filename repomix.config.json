{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "parsableStyle": true,
    "compress": true
  },
  "include": [
    "**/*"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".github/workflows/",
      ".vscode/",
      ".husky/",
      "docs/images/",
      "*.md",
      "frontend/public/",
      "test/",
      "tests/",
      ".secrets.baseline",
      ".aislop/"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
