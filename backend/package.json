{
  "name": "toique-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest --run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.0",
    "resend": "^6.28.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-istanbul": "^5.0.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "knip": "^6.37.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "vite": "^8.0.16",
    "brace-expansion": "^5.0.9",
    "postcss": "^8.5.18",
    "nanoid": "^3.3.17"
  }
}
