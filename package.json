{
  "name": "toique",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint": "bun --cwd backend run lint && bun --cwd frontend run lint",
    "format:check": "bun --cwd backend run format:check && bun --cwd frontend run format:check",
    "typecheck": "bun --cwd backend run typecheck && bun --cwd frontend run typecheck",
    "test": "bun --cwd backend run test && bun --cwd frontend run test",
    "knip": "bun --cwd backend run knip && bun --cwd frontend run knip",
    "secretlint": "git ls-files -z | xargs -0 secretlint",
    "detect-secrets:update": "detect-secrets --version | grep -qx 1.5.0 || { echo '[FATAL] detect-secrets 1.5.0 is required (.secrets.baseline records this version). Install it with: pip install detect-secrets==1.5.0'; exit 1; }; detect-secrets scan --baseline .secrets.baseline"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@secretlint/secretlint-formatter-sarif": "^13.0.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "husky": "^9.1.0",
    "lint-staged": "^17.1.1",
    "secretlint": "^13.0.2"
  },
  "lint-staged": {
    "**/*.{pem,key,p12,p8,keystore,jks,sqlite,db,log,http,rest,patch,diff,local}": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/.env": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/.env.*": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/*.env": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/*.env.*": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/*_rsa": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/*_ed25519": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/*_ecdsa": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/.npmrc": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/.netrc": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/*credentials*.json": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/*secret*.json": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/*.tfstate": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/*.tfstate.*": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/cdktf.out/**": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/.terraform/**": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/.cursor/**": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/.claude/**": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/.aider*/**": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/.windsurf/**": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/.jules/**": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/.Jules/**": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/{pr_body,pr_description,issue_body,commit-msg,commit_msg}*.{txt,md}": [
      "node scripts/fail-on-sensitive-file.mjs"
    ],
    "**/*": [
      "secretlint"
    ],
    "backend/src/**/*.ts": [
      "bun --cwd backend run lint --fix",
      "bun --cwd backend run format"
    ],
    "frontend/src/**/*.{ts,tsx}": [
      "bun --cwd frontend run lint --fix",
      "bun --cwd frontend run format"
    ]
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.1",
    "@hono/node-server": "^2.0.10",
    "hono": "^4.13.0",
    "ip-address": "^10.3.1",
    "qs": "6.16.0"
  }
}
