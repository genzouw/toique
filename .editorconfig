root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# drizzle-kit が生成するマイグレーション SQL はタブインデント。
# 手で開いて保存したときに生成物の差分を出さないよう、生成物側に合わせる。
[db/migrations/*.sql]
indent_style = tab
trim_trailing_whitespace = false

[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab
